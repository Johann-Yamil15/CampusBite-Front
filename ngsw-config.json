{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationRequestStrategy": "freshness",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "runtime-config",
      "urls": ["/config/runtime-config.json"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 1, "maxAge": "30d", "timeout": "3s" }
    },
    {
      "name": "api-campusbite",
      "urls": [
        "/api/**",
        "https://campusbite-back-dkeje8c0euefefat.centralus-01.azurewebsites.net/api/**"
      ],
      "cacheConfig": { "strategy": "freshness", "maxSize": 300, "maxAge": "7d", "timeout": "5s" }
    },
    {
      "name": "imagenes-productos",
      "urls": ["https://campusbiteimagenes.blob.core.windows.net/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 500, "maxAge": "30d" }
    }
  ]
}
