{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationRequestStrategy": "freshness",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-menu",
      "urls": [
        "/api/menu",
        "/api/menu/**",
        "https://campusbite-back-dkeje8c0euefefat.centralus-01.azurewebsites.net/api/menu",
        "https://campusbite-back-dkeje8c0euefefat.centralus-01.azurewebsites.net/api/menu/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 30,
        "maxAge": "1d",
        "timeout": "4s"
      }
    },
    {
      "name": "runtime-config",
      "urls": ["/config/runtime-config.json"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 1,
        "maxAge": "7d",
        "timeout": "3s"
      }
    }
  ]
}
